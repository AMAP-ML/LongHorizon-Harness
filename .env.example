# Kusudaemon environment — copy this file to `.env` and edit.
# `.env` is gitignored; the harness loads it automatically at CLI startup
# (variables already exported in your shell win over the file).
#
# Provider api keys live HERE, never in provider.json: each entry in
# provider.json names the env var holding its key via `api_key_env`.
# Add a fresh key for every provider you put in provider.json.

# --- Provider key (the only api key you need to start) -----------------------
# This is the key the built-in opencode provider uses (see provider.json's
# "api_key_env": "OPENAI_API_KEY"). More providers -> more keys, e.g.
# DEEPSEEK_API_KEY=...
OPENAI_API_KEY=

# --- Provider selection (optional) --------------------------------------------
# Which named provider from provider.json to use; defaults to the file's
# "default" entry (which defaults to "opencode").
# KUSUDAEMON_PROVIDER=opencode

# --- Optional knobs --------------------------------------------------------------
# Writer backend (only gptme exists in this harness).
# KUSUDAEMON_BACKEND=gptme
# Local SearXNG instance the `websearch` gptme tool queries for research
# nodes (see README's "Web search (optional)" section for the Docker
# setup). Defaults to http://localhost:8080 if unset.
# KUSUDAEMON_SEARXNG_URL=http://localhost:8080